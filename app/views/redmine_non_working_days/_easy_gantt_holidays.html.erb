<%#
  EasyGantt の標準機能 ysy.settings.holidays（"YYYY-MM-DD" の配列）に、
  本プラグインが管理する非稼働日（祝日・個別設定・定期ルール）を追加する。
  ysy.settings は _js_prepare（easy_gantt 側）で初期化済みのため、
  ガント初期化（$(document).ready 内の initNonworkingDays）より前に
  この body 末尾フックで上書きすれば反映される。
-%>
<%
  from  = Date.today - 1.year
  to    = Date.today + 2.years
  # weekday(標準曜日休業)は含めない。EasyGantt側は ysy.settings.nonWorkingWeekDays を
  # 別途参照して曜日を独自に処理しているため、ここに混ぜると holidays 配列が
  # 数百件膨張するだけで表示結果は変わらない(dhtml_rewrite.js参照)。
  dates = RedmineNonWorkingDays::Cache.expand_for_range(
    from, to, kinds: RedmineNonWorkingDays::Cache.entry_kinds).map { |e| e[:date].to_s }
%>
<%= javascript_tag do %>
  window.ysy = window.ysy || {};
  ysy.settings = ysy.settings || {};
  ysy.settings.holidays = (ysy.settings.holidays || []).concat(<%= raw dates.to_json %>);
<% end %>
